import ssl
import os
import threading
import urllib.request
import uuid
from typing import Any, List, Optional

from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import run_on_queue
from java import jarray, jclass
from org.telegram.messenger import ApplicationLoader
from ui.bulletin import BulletinHelper
from ui.settings import Divider, Header, Input, Switch, Text


__id__ = "face_privacy_round_video"
__name__ = "Face Privacy — Кружки"
__description__ = "Локально маскирует лица в исходящих видеокружках exteraGram."
__author__ = "Maduro"
__version__ = "1.0.4"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["media", "privacy", "tools"]

DEFAULT_ASSETS_BASE_URL = (
    "https://raw.githubusercontent.com/Quenby03/exteragram-voice-to-text/main/"
    "plugins/face_privacy_round_video/assets"
)

# Updated by the packaging step after the model and Android runtime are finalized.
ASSET_SHA256 = {
    "faceprivacy-runtime.jar": "2F8B325725E92108FA1487825AF0CF8966AD4056BD65474ED719A9B26E5C149E",
    "libonnxruntime.so": "8005A741E57117B4D7B476417706C0E9AF13CF1B89DB47E60F0CBC56E1AF91E0",
    "libonnxruntime4j_jni.so": "5F2F1A99FD9F65FD6271EED825632F4AE5ADA95F5CC13D66605888CCB80CDC29",
    "yolov11n-face.onnx": "44F6C3EC27061DC61D32529708CF3FDDD99BC39191551AA6EB3EC00EB50C6BA0",
}


class FacePrivacyRoundVideoPlugin(BasePlugin):
    """Fail-closed, fully local processing for outgoing round videos."""

    def on_plugin_load(self):
        self._pending = set()
        self._pending_lock = threading.RLock()
        self._runtime_loader = None
        self._runtime_class = None
        self.add_on_send_message_hook(priority=100)
        self.logger.info("Face Privacy for Round Videos loaded")

    def on_plugin_unload(self):
        self.logger.info("Face Privacy for Round Videos unloaded")

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Защита лица в видеокружках"),
            Switch(
                key="enabled",
                text="Обрабатывать исходящие кружки",
                subtext="Видео сначала обрабатывается на устройстве и только потом отправляется",
                default=True,
                icon="msg_video",
            ),
            Input(
                key="mode",
                text="Режим маски",
                subtext="pixelate, blur или solid",
                default="pixelate",
                icon="msg_settings",
            ),
            Input(
                key="detect_every",
                text="Частота распознавания",
                subtext="Каждый N-й кадр; 2 = каждый второй кадр",
                default="2",
                icon="msg_settings",
            ),
            Input(
                key="confidence",
                text="Порог уверенности YOLO",
                subtext="Число от 0.05 до 0.95; значение по умолчанию 0.35",
                default="0.35",
                icon="msg_settings",
            ),
            Input(
                key="nms_iou",
                text="Подавление дубликатов рамок",
                subtext="IoU от 0.05 до 0.95; по умолчанию 0.45",
                default="0.45",
                icon="msg_settings",
            ),
            Input(
                key="padding_percent",
                text="Запас вокруг лица (%)",
                subtext="Маска расширяется вокруг найденной рамки",
                default="25",
                icon="msg_settings",
            ),
            Input(
                key="hold_frames",
                text="Удерживать маску (кадры)",
                subtext="По умолчанию 15 кадров после последнего обнаружения",
                default="15",
                icon="msg_settings",
            ),
            Input(
                key="pixel_block",
                text="Размер блока пикселизации",
                subtext="5×5 оставляет около 4% исходных пикселей лица",
                default="5",
                icon="msg_settings",
            ),
            Input(
                key="blur_radius",
                text="Радиус размытия",
                subtext="Используется в режиме blur, значение в пикселях",
                default="16",
                icon="msg_settings",
            ),
            Input(
                key="mask_color",
                text="Цвет полной маски",
                subtext="HEX, например #000000 или #202020; режим solid",
                default="#000000",
                icon="msg_settings",
            ),
            Input(
                key="bitrate_mbps",
                text="Битрейт выходного видео (Мбит/с)",
                subtext="0.4–12; размер и частота кадров сохраняются",
                default="2.5",
                icon="msg_settings",
            ),
            Switch(
                key="nnapi",
                text="Ускорение через Android NNAPI",
                subtext="Для Pixel 9 Pro; при недоступности используется CPU",
                default=True,
